  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#64748b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comment delimiters",
      "scope": [
        "comment punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#64748b",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7c3aed"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#0e7490"
      }
    },
    {
      "scope": [
        "string",
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#15803d"
      }
    },
    {
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#0e7490"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#b45309"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#0369a1"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#0e7490"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#be123c"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#a16207"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter",
        "punctuation"
      ],
      "settings": {
        "foreground": "#263238"
      }
    },
    {
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#1e3f7a"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#0f766e",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "heading.1.markdown",
      "settings": {
        "foreground": "#0f766e",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "heading.2.markdown",
      "settings": {
        "foreground": "#0e7490",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "heading.3.markdown",
      "settings": {
        "foreground": "#0369a1",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "heading.4.markdown",
      "settings": {
        "foreground": "#3b00db",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "heading.5.markdown",
      "settings": {
        "foreground": "#4f46e5",
        "fontStyle": ""
      }
    },
    {
      "scope": "heading.6.markdown",
      "settings": {
        "foreground": "#6366f1",
        "fontStyle": ""
      }
    },
    {
      "scope": "markup.heading.setext.1",
      "settings": {
        "foreground": "#0f766e",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.heading.setext.2",
      "settings": {
        "foreground": "#0e7490",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "foreground": "#111827",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "foreground": "#7c3aed",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.strikethrough",
      "settings": {
        "foreground": "#9ca3af",
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": "markup.inline.raw",
      "settings": {
        "foreground": "#c2410c"
      }
    },
    {
      "scope": [
        "markup.fenced_code.block",
        "markup.raw.block"
      ],
      "settings": {
        "foreground": "#263238"
      }
    },
    {
      "scope": [
        "markup.quote",
        "punctuation.definition.quote.begin.markdown"
      ],
      "settings": {
        "foreground": "#15803d",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "punctuation.definition.list.begin.markdown",
      "settings": {
        "foreground": "#7B3F00",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string.other.link.title.markdown",
        "string.other.link.description.markdown"
      ],
      "settings": {
        "foreground": "#2563eb"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "markup.underline.link.image"
      ],
      "settings": {
        "foreground": "#2563eb",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "punctuation.definition.table.markdown",
        "punctuation.separator.table.markdown"
      ],
      "settings": {
        "foreground": "#cbd5e1"
      }
    },
    {
      "name": "Markdown Inline Code",
      "scope": [
        "markup.inline.raw.string.markdown"
      ],
      "settings": {
        "foreground": "#c2410ccc"
      }
    },
    {
      "name": "Markdown Horizontal Rule",
      "scope": [
        "meta.separator.markdown"
      ],
      "settings": {
        "foreground": "#a78bfa"
      }
    },
    {
      "name": "Type Name",
      "scope": [
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#0f766e"
      }
    },
    {
      "name": "Class Name",
      "scope": [
        "entity.name.type.class",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#007fff"
      }
    },
    {
      "name": "Doc comments",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "comment.block.documentation punctuation",
        "comment.block.documentation punctuation.definition.comment",
        "comment.line.documentation punctuation.definition.comment",
        "string.quoted.docstring",
        "string.quoted.docstring.multi.python punctuation.definition.string.begin",
        "string.quoted.docstring.multi.python punctuation.definition.string.end"
      ],
      "settings": {
        "foreground": "#8db600",
        "fontStyle": "italic"
      }
    },
    {
      "name": "TODO / FIXME tags",
      "scope": [
        "keyword.codetag.notation"
      ],
      "settings": {
        "foreground": "#a16207",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Raw strings",
      "scope": [
        "string.quoted.raw",
        "string.regexp.quoted"
      ],
      "settings": {
        "foreground": "#5c7c2a"
      }
    },
    {
      "name": "f-strings",
      "scope": [
        "meta.fstring.python string",
        "meta.fstring.python string.quoted.raw",
        "meta.fstring.python storage.type.string",
        "meta.fstring.python storage.type.format",
        "meta.fstring.python constant.character.format.placeholder",
        "meta.fstring.python punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#5f8a00"
      }
    },
    {
      "name": "Built-in exceptions",
      "scope": [
        "support.type.exception.python"
      ],
      "settings": {
        "foreground": "#b3434a"
      }
    },
    {
      "name": "global / nonlocal",
      "scope": [
        "storage.modifier.declaration.python"
      ],
      "settings": {
        "foreground": "#6f00ff"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "entity.name.function.decorator.python",
        "punctuation.definition.decorator.python"
      ],
      "settings": {
        "foreground": "#7d6470",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#be185d"
      }
    },
    {
      "name": "self / cls in signature",
      "scope": [
        "variable.parameter.function.language.special.self",
        "variable.parameter.function.language.special.cls"
      ],
      "settings": {
        "foreground": "#a16207"
      }
    },
    {
      "name": "self / cls in body",
      "scope": [
        "variable.language.special.self",
        "variable.language.special.cls"
      ],
      "settings": {
        "foreground": "#a24d5c"
      }
    },
    {
      "name": "Log errors",
      "scope": [
        "log.error",
        "log.exceptiontype"
      ],
      "settings": {
        "foreground": "#be123c"
      }
    },
    {
      "name": "Log stack traces",
      "scope": [
        "log.exception"
      ],
      "settings": {
        "foreground": "#a0467e"
      }
    },
    {
      "name": "Log warnings",
      "scope": [
        "log.warning"
      ],
      "settings": {
        "foreground": "#a16207"
      }
    },
    {
      "name": "Log info",
      "scope": [
        "log.info"
      ],
      "settings": {
        "foreground": "#0e7490"
      }
    },
    {
      "name": "Log constants",
      "scope": [
        "log.constant",
        "text.log constant.language"
      ],
      "settings": {
        "foreground": "#57534e"
      }
    },
